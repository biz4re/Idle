{
  "name": "idle",
  "productName": "Idle",
  "version": "0.1.2",
  "private": true,
  "description": "An open-source, macOS-first Chromium browser.",
  "license": "Apache-2.0",
  "main": "out/main/index.js",
  "files": [
    "out/",
    "resources/"
  ],
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/*.test.mjs",
    "build": "tsc --noEmit && electron-vite build",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "start": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "emoji-picker-react": "^5.1.4",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldts": "^7.4.19",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.biz4re.idle",
    "productName": "Idle",
    "directories": {
      "output": "release/builder"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "biz4re",
        "repo": "Idle"
      }
    ],
    "detectUpdateChannel": true,
    "win": {
      "artifactName": "Idle-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
