---
interface Props {
  class?: string;
  variant?: 'default' | 'waving';
}

const { class: className = "w-4 h-4", variant = 'default' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <!-- Idle's friendly ghost silhouette -->
  <path d="M12 2a8 8 0 0 0-8 8v10c0 .6.4 1 1 1 1 0 1.5-.7 2-1.2.5.5 1 1.2 2 1.2s1.5-.7 2-1.2c.5.5 1 1.2 2 1.2s1.5-.7 2-1.2c.5.5 1 1.2 2 1.2.6 0 1-.4 1-1V10a8 8 0 0 0-8-8z" />
  <!-- Friendly eyes -->
  <circle cx="9" cy="10" r="1" fill="currentColor" stroke="none" />
  <circle cx="15" cy="10" r="1" fill="currentColor" stroke="none" />
  {variant === 'waving' && (
    <path d="M19.5 13c1.5-1.2 2.8-2.8 2.2-4.2-.6-1.3-2-.7-2.9.8" stroke-width="2" />
  )}
</svg>
