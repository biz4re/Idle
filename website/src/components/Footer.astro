---
import { DOWNLOAD_CONFIG } from '../config/downloads';
import GhostIcon from './GhostIcon.astro';
---

<footer class="border-t border-charcoal-border bg-warm-bg text-charcoal-muted text-xs py-16">
  <div class="max-w-7xl mx-auto px-6 sm:px-10 space-y-10">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8">
      <!-- Brand & tagline -->
      <div class="space-y-1">
        <div class="flex items-center gap-2.5 text-charcoal font-bold text-base">
          <div class="w-6 h-6 rounded-lg bg-idle-green text-warm-bg flex items-center justify-center shadow-xs">
            <GhostIcon class="w-3.5 h-3.5 text-warm-bg" />
          </div>
          <span>Idle</span>
        </div>
        <p class="font-serif italic text-charcoal-light text-xs">
          A quieter way to browse.
        </p>
      </div>

      <!-- Navigation Links -->
      <div class="flex flex-wrap items-center gap-6 text-xs font-medium text-charcoal">
        <a href="#tabs" class="hover:text-idle-green transition-colors">Tabs</a>
        <a href="#spaces" class="hover:text-idle-green transition-colors">Spaces</a>
        <a href="#split" class="hover:text-idle-green transition-colors">Split View</a>
        <a href="#later" class="hover:text-idle-green transition-colors">Later</a>
        <a href="#philosophy" class="hover:text-idle-green transition-colors">Manifesto</a>
      </div>
    </div>

    <!-- Sub-links and closing sign-off -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-6 border-t border-charcoal-border-subtle text-charcoal-light">
      <div class="flex flex-wrap items-center gap-6 text-xs">
        <a
          href={DOWNLOAD_CONFIG.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-charcoal transition-colors inline-flex items-center gap-1"
        >
          <span>GitHub</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href={`${DOWNLOAD_CONFIG.githubUrl}/blob/master/KNOWN_ISSUES.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-charcoal transition-colors inline-flex items-center gap-1"
        >
          <span>Known Issues</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href={`${DOWNLOAD_CONFIG.githubUrl}/blob/master/LICENSE`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-charcoal transition-colors inline-flex items-center gap-1"
        >
          <span>Apache-2.0 License</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <p class="text-xs font-serif italic text-charcoal-muted">
        Made for the modern internet. Haunted by a friendly ghost.
      </p>
    </div>
  </div>
</footer>
