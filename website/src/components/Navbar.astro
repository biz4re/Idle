---
import { DOWNLOAD_CONFIG } from '../config/downloads';
import GhostIcon from './GhostIcon.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const downloadHref = DOWNLOAD_CONFIG.hasVerifiedInstallers
  ? (DOWNLOAD_CONFIG.installers?.mac?.url ?? DOWNLOAD_CONFIG.targetAnchor)
  : DOWNLOAD_CONFIG.targetAnchor;
---

<header class="w-full z-40 bg-warm-bg/90 backdrop-blur-md sticky top-0 transition-all border-b border-charcoal-border-subtle">
  <div class="max-w-7xl mx-auto px-6 sm:px-10 h-20 flex items-center justify-between">
    <!-- Brand with friendly ghost mascot -->
    <a href={baseUrl} class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-idle-green rounded-lg py-1">
      <div class="w-8 h-8 rounded-xl bg-idle-green text-warm-bg flex items-center justify-center shadow-xs transition-transform group-hover:scale-105">
        <GhostIcon class="w-4 h-4 text-warm-bg" />
      </div>
      <span class="font-bold text-xl tracking-tight text-charcoal">Idle</span>
    </a>

    <!-- Navigation Actions -->
    <nav class="flex items-center gap-7 text-sm font-medium" aria-label="Main navigation">
      <a href="#tabs" class="text-charcoal-muted hover:text-charcoal transition-colors hidden sm:inline-block">
        Tabs
      </a>
      <a href="#spaces" class="text-charcoal-muted hover:text-charcoal transition-colors hidden sm:inline-block">
        Spaces
      </a>
      <a href="#split" class="text-charcoal-muted hover:text-charcoal transition-colors hidden md:inline-block">
        Split View
      </a>
      <a href="#later" class="text-charcoal-muted hover:text-charcoal transition-colors hidden sm:inline-block">
        Later
      </a>
      
      <!-- Prominent Download CTA Button in Idle Green -->
      <a
        href={downloadHref}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-semibold bg-idle-green text-warm-bg hover:bg-idle-green-hover transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-idle-green shadow-sm hover:shadow-md"
      >
        <span>{DOWNLOAD_CONFIG.ctaText}</span>
        {!DOWNLOAD_CONFIG.hasVerifiedInstallers && (
          <span class="text-[10px] opacity-80 font-normal">· {DOWNLOAD_CONFIG.statusBadge}</span>
        )}
      </a>
    </nav>
  </div>
</header>
