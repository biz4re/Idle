---
import { DOWNLOAD_CONFIG } from '../config/downloads';
import GhostIcon from './GhostIcon.astro';

const downloadHref = DOWNLOAD_CONFIG.hasVerifiedInstallers
  ? (DOWNLOAD_CONFIG.installers?.mac?.url ?? DOWNLOAD_CONFIG.targetAnchor)
  : DOWNLOAD_CONFIG.targetAnchor;
---

<section id="hero" class="relative pt-16 pb-20 sm:pt-24 sm:pb-32 overflow-hidden text-center">
  <div class="max-w-7xl mx-auto px-6 sm:px-10 space-y-10">
    
    <!-- Hero Copy Header -->
    <div class="max-w-4xl mx-auto space-y-6">
      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-idle-green-soft text-idle-green text-sm font-serif italic">
        <GhostIcon class="w-4 h-4 text-idle-green shrink-0" />
        <span>Meet Idle. Your new favourite browser.</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-bold tracking-tighter text-charcoal leading-[0.96]">
        The world moved on. <br/>
        <span class="font-serif italic font-normal text-idle-green">Your browser didn’t.</span>
      </h1>

      <!-- Supporting Body -->
      <p class="text-xl sm:text-2xl text-charcoal-muted font-normal leading-relaxed max-w-2xl mx-auto pt-2">
        Meet Idle. A fresh take on browsing, built for how we live online today. Smarter tabs, organised spaces, and a little less chaos.
      </p>

      <!-- Action Buttons -->
      <div class="pt-2 flex flex-col items-center gap-4">
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={downloadHref}
            class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-idle-green text-warm-bg text-base font-semibold hover:bg-idle-green-hover transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-idle-green shadow-md hover:shadow-lg"
          >
            <span>{DOWNLOAD_CONFIG.ctaText}</span>
            <svg aria-hidden="true" class="w-4 h-4 text-warm-bg/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          
          <a
            href="#problem"
            class="inline-flex items-center gap-2 px-6 py-4 rounded-full text-charcoal font-medium hover:text-idle-green transition-colors text-sm"
          >
            <span>Explore what's inside</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>

        <div class="space-y-1 text-center">
          <p class="text-sm font-serif italic text-charcoal-muted">
            Free. Open source. No funny business.
          </p>
          <p class="text-xs text-charcoal-light">
            Developer Preview {DOWNLOAD_CONFIG.version} · {DOWNLOAD_CONFIG.statusMessage}
          </p>
        </div>
      </div>
    </div>



  </div>
</section>
