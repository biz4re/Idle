---
import Layout from '../layouts/Layout.astro';
import Features from '../components/Features.astro';
import PreviewFrame from '../components/PreviewFrame.astro';
import { DOWNLOAD_CONFIG } from '../config/downloads';
const iconUrl = import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'idle-icon.png';
const downloadHref = DOWNLOAD_CONFIG.githubUrl + '/releases';
---
<Layout title="Idle — A little more room to wander" description="A calmer browser for everything you do online. Meet Idle: spaces, thoughtful tabs, split view, and room to wander.">
  <header class="site-header">
    <a class="header-wordmark" href="#top">idle</a>
    <a class="header-logo" href="#top" aria-label="Idle home"><img src={iconUrl} alt="" /></a>
    <a class="nav-cta windows-download" href={downloadHref}>Download for Windows</a>
  </header>
  <main id="content">
    <section id="top" class="hero">
      <div class="hero-copy"><span class="eyebrow"><span class="status-dot"></span> A BROWSER FOR BEING ONLINE</span><h1>A little more room <em>to wander.</em></h1><p>The internet is a wonderful place. Your browser should make it feel that way.</p><div class="hero-actions"><a class="button button-dark windows-download" href={downloadHref}>Download for Windows</a><a class="text-link" href="#features">Take a look <span>↓</span></a></div><span class="availability">Free & open source · Windows developer preview</span></div>
      <div class="hero-art"><PreviewFrame mode="tabs" label="Try Idle’s browser interface" eager /></div>
      <div class="hero-bottom"><span>MADE FOR THE WAY YOU BROWSE</span><span>SCROLL TO EXPLORE ↓</span></div>
    </section>
    <section id="features" class="intro section-wrap"><div class="section-kicker">A LITTLE LESS NOISE <span>✳</span></div><div><h2>The web is big.<br/><em>Make it yours.</em></h2><p>Idle brings a little breathing room to your browsing, so you can follow your curiosity without losing your place.</p></div></section>
    <Features />
    <section id="download" class="closing"><span class="eyebrow">A BETTER WINDOW TO THE WEB</span><h2>Go on.<br/><em>Get lost.</em></h2><p>There’s a whole world out there. We made a little more room for you to explore it.</p><div class="closing-actions"><a class="button button-light windows-download" href={downloadHref}>Download for Windows</a></div><small>The latest published Windows installer is served from GitHub. macOS and Linux installers are not yet available.</small><div class="closing-ghost"><img src={iconUrl} alt="" /></div></section>
  </main>
  <div class="download-dock"><span>Ready for a quieter browser?</span><a class="windows-download" href={downloadHref}>Download for Windows</a></div>
  <footer class="site-footer"><a class="brand" href="#top"><span class="brand-icon"><img src={iconUrl} alt="" /></span><span>idle</span></a><p>A quieter way to browse.<br/>Made for a wonderful web.</p><div><a href="#features">Explore</a><a href={DOWNLOAD_CONFIG.githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={`${DOWNLOAD_CONFIG.githubUrl}/blob/master/LICENSE`} target="_blank" rel="noopener noreferrer">License ↗</a></div><span>© IDLE BROWSER</span></footer>
  <script>
    const releasePage = 'https://github.com/biz4re/Idle/releases';
    const links = document.querySelectorAll<HTMLAnchorElement>('.windows-download');
    fetch('https://api.github.com/repos/biz4re/Idle/releases', { headers: { Accept: 'application/vnd.github+json' } })
      .then((response) => {
        if (!response.ok) throw new Error('GitHub releases unavailable');
        return response.json();
      })
      .then((releases: unknown) => {
        if (!Array.isArray(releases)) return;
        const release = releases.find((item) => !item.draft && Array.isArray(item.assets) && item.assets.some((asset: { name?: string; browser_download_url?: string }) => /^Idle-Setup-.*\.exe$/i.test(asset.name ?? '') && asset.browser_download_url?.startsWith('https://github.com/biz4re/Idle/releases/download/')));
        const installer = release?.assets.find((asset: { name?: string; browser_download_url?: string }) => /^Idle-Setup-.*\.exe$/i.test(asset.name ?? '') && asset.browser_download_url?.startsWith('https://github.com/biz4re/Idle/releases/download/'));
        if (installer?.browser_download_url) links.forEach((link) => { link.href = installer.browser_download_url; });
      })
      .catch(() => { links.forEach((link) => { link.href = releasePage; }); });
  </script>
</Layout>
